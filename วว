<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JLPT N2 Flashcard Master 🌸</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Sarabun:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Sarabun', 'Noto Sans JP', sans-serif;
        }
        .perspective-1000 {
            perspective: 1000px;
        }
        .transform-style-3d {
            transform-style: preserve-3d;
        }
        .backface-hidden {
            backface-visibility: hidden;
        }
        .rotate-y-180 {
            transform: rotateY(180deg);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-pink-50 via-indigo-50 to-blue-100 min-h-screen flex flex-col justify-between text-gray-800">

    <header class="bg-white/80 backdrop-blur-md shadow-sm py-4 px-6 sticky top-0 z-50">
        <div class="max-w-2xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <span class="text-2xl">🌸</span>
                <h1 class="text-xl font-bold bg-gradient-to-r from-pink-600 to-indigo-600 bg-clip-text text-transparent">JLPT N2 Flashcard</h1>
            </div>
            <div class="flex items-center space-x-3">
                <button onclick="shuffleCards()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium transition flex items-center space-x-1 shadow-sm">
                    <span>🔀 สับการ์ด</span>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-xl w-full mx-auto p-4 flex-grow flex flex-col justify-center">
        
        <div class="mb-4">
            <div class="flex justify-between text-sm font-semibold text-gray-600 mb-1">
                <span id="progress-text">การ์ดที่ 1 / 15</span>
                <span id="score-text" class="text-indigo-600">จำได้แล้ว: 0 คำ</span>
            </div>
            <div class="w-full bg-gray-200 h-2.5 rounded-full overflow-hidden shadow-inner">
                <div id="progress-bar" class="bg-gradient-to-r from-pink-500 to-indigo-600 h-2.5 rounded-full transition-all duration-300" style="width: 6.67%"></div>
            </div>
        </div>

        <div class="perspective-1000 w-full h-96 cursor-pointer mb-6" onclick="flipCard()">
            <div id="flashcard-inner" class="relative w-full h-full duration-500 transform-style-3d shadow-xl rounded-3xl">
                
                <div class="absolute inset-0 w-full h-full bg-white rounded-3xl p-6 flex flex-col justify-between backface-hidden border border-pink-100">
                    <div class="flex justify-between items-center">
                        <span class="bg-pink-100 text-pink-700 text-xs font-bold px-3 py-1 rounded-full">JLPT N2 Vocabulary</span>
                        <button onclick="event.stopPropagation(); speakWord();" class="p-2.5 bg-pink-50 hover:bg-pink-100 text-pink-600 rounded-full transition shadow-sm" title="ฟังเสียงอ่าน">
                            🔊
                        </button>
                    </div>
                    
                    <div class="text-center my-auto">
                        <h2 id="card-kanji" class="text-6xl font-bold text-gray-800 mb-2 font-['Noto_Sans_JP']"></h2>
                        <p id="card-hiragana" class="text-xl text-indigo-600 font-medium"></p>
                    </div>

                    <div class="text-center text-xs text-gray-400">
                        คลิกที่การ์ดหรือปุ่มด้านล่างเพื่อพลิกดูความหมาย 👆
                    </div>
                </div>

                <div class="absolute inset-0 w-full h-full bg-gradient-to-br from-indigo-900 to-slate-900 text-white rounded-3xl p-6 flex flex-col justify-between backface-hidden rotate-y-180">
                    <div class="flex justify-between items-center">
                        <span class="bg-indigo-700/50 text-indigo-200 text-xs font-bold px-3 py-1 rounded-full">ความหมาย & ตัวอย่าง</span>
                        <button onclick="event.stopPropagation(); speakWord();" class="p-2.5 bg-indigo-800 hover:bg-indigo-700 text-white rounded-full transition shadow-sm" title="ฟังเสียงอ่าน">
                            🔊
                        </button>
                    </div>

                    <div class="my-auto text-center">
                        <h3 id="card-romaji" class="text-sm text-indigo-300 mb-1 tracking-wide"></h3>
                        <h2 id="card-meaning" class="text-2xl font-bold text-pink-300 mb-4"></h2>
                        <div class="bg-white/10 backdrop-blur-sm p-3 rounded-xl text-left border border-white/10">
                            <p class="text-xs text-indigo-200 font-semibold mb-1">💡 ตัวอย่างประโยค:</p>
                            <p id="card-example-jp" class="text-sm text-white mb-1 font-['Noto_Sans_JP']"></p>
                            <p id="card-example-th" class="text-xs text-gray-300"></p>
                        </div>
                    </div>

                    <div class="text-center text-xs text-indigo-300">
                        เลือกสถานะการเรียนรู้ด้านล่าง 👇
                    </div>
                </div>

            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <button onclick="nextCard(false)" class="bg-white hover:bg-red-50 text-red-600 border border-red-200 font-semibold py-3 px-4 rounded-2xl shadow-sm transition flex items-center justify-center space-x-2">
                <span>❌ ยังจำไม่ได้</span>
            </button>
            <button onclick="nextCard(true)" class="bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-semibold py-3 px-4 rounded-2xl shadow-md transition flex items-center justify-center space-x-2">
                <span>✨ จำได้แล้ว</span>
            </button>
        </div>

    </main>

    <div id="completion-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-3xl max-w-sm w-full p-6 text-center shadow-2xl transform transition-all">
            <div class="text-5xl mb-3">🎉</div>
            <h3 class="text-2xl font-bold text-gray-800 mb-2">ยอดเยี่ยมมาก!</h3>
            <p class="text-gray-600 text-sm mb-4">คุณทบทวนคำศัพท์ชุดนี้ครบเรียบร้อยแล้วครับ</p>
            <div class="bg-pink-50 p-4 rounded-2xl mb-6">
                <p class="text-xs text-pink-600 font-semibold">คะแนนความจำของคุณ</p>
                <p id="final-score" class="text-3xl font-extrabold text-pink-700">0 / 15</p>
            </div>
            <button onclick="restartQuiz()" class="w-full bg-gradient-to-r from-pink-600 to-indigo-600 text-white font-bold py-3 rounded-xl shadow-md hover:opacity-90 transition">
                🔄 เริ่มทบทวนใหม่อีกครั้ง
            </button>
        </div>
    </div>

    <footer class="text-center py-4 text-xs text-gray-500">
        JLPT N2 Vocabulary Flashcard App &bull; Powered by Web Speech API & Tailwind CSS
    </footer>

    <script>
        // 🗂️ ชุดข้อมูลคำศัพท์ JLPT N2 (Dataset)
        const vocabularyData = [
            {
                kanji: "影響",
                hiragana: "えいきょう",
                romaji: "eikyou",
                meaning: "อิทธิพล, ผลกระทบ",
                exampleJp: "コロナウイルスは世界経済に大きな影響を与えた。",
                exampleTh: "ไวรัสโคโรนาส่งผลกระทบอย่างมากต่อเศรษฐกิจโลก"
            },
            {
                kanji: "原因",
                hiragana: "げんいん",
                romaji: "genin",
                meaning: "สาเหตุ",
                exampleJp: "事故の原因を調査する。",
                exampleTh: "สืบสวนหาสาเหตุของอุบัติเหตุ"
            },
            {
                kanji: "期待",
                hiragana: "きたい",
                romaji: "kitai",
                meaning: "ความคาดหวัง",
                exampleJp: "親の期待に応えるために頑張る。",
                exampleTh: "พยายามเพื่อตอบสนองความคาดหวังของพ่อแม่"
            },
            {
                kanji: "複雑",
                hiragana: "ふくざつ",
                romaji: "fukuzatsu",
                meaning: "ซับซ้อน",
                exampleJp: "この問題は非常に複雑だ。",
                exampleTh: "ปัญหานี้มีความซับซ้อนมาก"
            },
            {
                kanji: "可能",
                hiragana: "かのう",
                romaji: "kanou",
                meaning: "เป็นไปได้",
                exampleJp: "努力すれば、夢は実現可能です。",
                exampleTh: "หากมีความพยายาม ความฝันก็เป็นจริงได้"
            },
            {
                kanji: "主張",
                hiragana: "しゅちょう",
                romaji: "shuchou",
                meaning: "การยืนยันความคิดของตนเอง, การเรียกร้อง",
                exampleJp: "彼は自分の意見を強く主張した。",
                exampleTh: "เขา দাঁড়ยันความคิดเห็นของตัวเองอย่างหนักแน่น"
            },
            {
                kanji: "程度",
                hiragana: "ていど",
                romaji: "teido",
                meaning: "ระดับ, ประมาณ",
                exampleJp: "日本語が少し話せる程度です。",
                exampleTh: "เป็นระดับที่สามารถพูดภาษาญี่ปุ่นได้นิดหน่อย"
            },
            {
                kanji: "実際",
                hiragana: "じっさい",
                romaji: "jissai",
                meaning: "ความเป็นจริง, ตามจริง",
                exampleJp: "実際に現場へ行って確認してみる。",
                exampleTh: "ลองไปดูสถานที่จริงเพื่อตรวจสอบ"
            },
            {
                kanji: "増加",
                hiragana: "ぞうか",
                romaji: "zouka",
                meaning: "การเพิ่มขึ้น",
                exampleJp: "観光客の数が年々増加している。",
                exampleTh: "จำนวนนักท่องเที่ยวเพิ่มขึ้นทุกปี"
            },
            {
                kanji: "基準",
                hiragana: "きじゅん",
                romaji: "kijun",
                meaning: "เกณฑ์, มาตรฐาน",
                exampleJp: "採用の基準を満たしている。",
                exampleTh: "ผ่านเกณฑ์การรับสมัคร"
            },
            {
                kanji: "責任",
                hiragana: "せきにん",
                romaji: "sekinin",
                meaning: "ความรับผิดชอบ",
                exampleJp: "自分の行動には責任を持たなければならない。",
                exampleTh: "ต้องมีความรับผิดชอบต่อการกระทำของตนเอง"
            },
            {
                kanji: "意識",
                hiragana: "いしき",
                romaji: "ishiki",
                meaning: "สติ, การตระหนักรู้",
                exampleJp: "健康を意識して野菜を多く食べる。",
                exampleTh: "ตระหนักถึงสุขภาพจึงกินผักให้มากขึ้น"
            },
            {
                kanji: "選択",
                hiragana: "せんたく",
                romaji: "sentaku",
                meaning: "การเลือก",
                exampleJp: "将来の進路を選択する時期だ。",
                exampleTh: "เป็นช่วงเวลาในการเลือกเส้นทางอนาคต"
            },
            {
                kanji: "納得",
                hiragana: "なっとく",
                romaji: "nattoku",
                meaning: "การเข้าใจและยอมรับ,หายข้องใจ",
                exampleJp: "彼の説明にやっと納得できた。",
                exampleTh: "ในที่สุดก็เข้าใจและยอมรับคำอธิบายของเขาได้"
            },
            {
                kanji: "貴重",
                hiragana: "きちょう",
                romaji: "kichou",
                meaning: "มีค่า, Lล้ำค่า",
                exampleJp: "貴重な体験をさせていただきました。",
                exampleTh: "ได้รับประสบการณ์อันล้ำค่ามาครับ"
            }
        ];

        let currentIndex = 0;
        let score = 0;
        let isFlipped = false;
        let currentCards = [...vocabularyData];

        // DOM Elements
        const cardInner = document.getElementById('flashcard-inner');
        const cardKanji = document.getElementById('card-kanji');
        const cardHiragana = document.getElementById('card-hiragana');
        const cardRomaji = document.getElementById('card-romaji');
        const cardMeaning = document.getElementById('card-meaning');
        const cardExampleJp = document.getElementById('card-example-jp');
        const cardExampleTh = document.getElementById('card-example-th');
        const progressBar = document.getElementById('progress-bar');
        const progressText = document.getElementById('progress-text');
        const scoreText = document.getElementById('score-text');
        const completionModal = document.getElementById('completion-modal');
        const finalScore = document.getElementById('final-score');

        // Initialize App
        function initCard() {
            const card = currentCards[currentIndex];
            cardKanji.textContent = card.kanji;
            cardHiragana.textContent = card.hiragana;
            cardRomaji.textContent = card.romaji;
            cardMeaning.textContent = card.meaning;
            cardExampleJp.textContent = card.exampleJp;
            cardExampleTh.textContent = card.exampleTh;

            // Reset flip state
            if (isFlipped) {
                flipCard();
            }

            // Update Progress
            const progressPercent = ((currentIndex + 1) / currentCards.length) * 100;
            progressBar.style.width = `${progressPercent}%`;
            progressText.textContent = `การ์ดที่ ${currentIndex + 1} / ${currentCards.length}`;
            scoreText.textContent = `จำได้แล้ว: ${score} คำ`;
        }

        // Flip Card Action
        function flipCard() {
            isFlipped = !isFlipped;
            if (isFlipped) {
                cardInner.classList.add('rotate-y-180');
                speakWord(); // อ่านเสียงอัตโนมัติเมื่อพลิกดูคำแปล
            } else {
                cardInner.classList.remove('rotate-y-180');
            }
        }

        // Next Card Action (Got it / Still learning)
        function nextCard(isGotIt) {
            if (isGotIt) {
                score++;
            }

            currentIndex++;

            if (currentIndex < currentCards.length) {
                initCard();
            } else {
                showCompletion();
            }
        }

        // Shuffle Cards
        function shuffleCards() {
            currentCards.sort(() => Math.random() - 0.5);
            currentIndex = 0;
            score = 0;
            initCard();
        }

        // Text-to-Speech (Web Speech API)
        function speakWord() {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel(); // หยุดเสียงค้างเดิม
                const card = currentCards[currentIndex];
                const textToSpeak = card.kanji; // หรือจะใช้ card.hiragana
                const utterance = new SpeechSynthesisUtterance(textToSpeak);
                utterance.lang = 'ja-JP';
                utterance.rate = 0.9; // ความเร็วปกติค่อนไปทางช้า เหมาะกับการเรียนรู้
                window.speechSynthesis.speak(utterance);
            }
        }

        // Show Completion Modal
        function showCompletion() {
            finalScore.textContent = `${score} / ${currentCards.length}`;
            completionModal.classList.remove('hidden');
        }

        // Restart Quiz
        function restartQuiz() {
            completionModal.classList.add('hidden');
            currentIndex = 0;
            score = 0;
            shuffleCards();
        }

        // Run first load
        window.onload = () => {
            initCard();
        };
    </script>
</body>
</html>
